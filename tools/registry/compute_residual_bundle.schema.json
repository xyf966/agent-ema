{
  "name": "compute_residual_bundle",
  "version": "EMA-RESIDUAL-1.0",
  "description": "Compute physical residuals from approved observations, with explicit optional command-based compensation.",
  "parameters": {
    "type": "object",
    "properties": {
      "case_id": {"type": "string", "pattern": "^CASE-[0-9a-f]{32}$"},
      "load_assumption": {"type": "string", "enum": ["none", "prescribed_command"], "default": "none"}
    },
    "required": ["case_id"],
    "additionalProperties": false
  },
  "statuses": ["ok", "not_applicable", "insufficient_data", "execution_error"],
  "returns_raw_waveforms": false,
  "allows_path_arguments": false,
  "array_references": "opaque_bundle_and_evidence_ids"
}
